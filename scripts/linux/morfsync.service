# Service systemd pour morfSync.
#
# Le service tourne EN TANT QUE L'UTILISATEUR (User=/Group=). Ses données sont de
# l'ÉTAT PERSISTANT sous /var/lib/morfsystem/morfsync (doctrine morfSystem,
# docs/FILESYSTEM.md) : StateDirectory= fait créer ce dossier par systemd, possédé
# par User= et accessible en écriture, puis l'expose via $STATE_DIRECTORY. Plus
# besoin de provisionner les droits à la main. morfdeploy remplace __RUN_USER__,
# __RUN_HOME__, __APP_DIR__ et __CONFIG_DIR__.
#
# Nom d'unité : « morfsync ». Binaire et config dans __APP_DIR__
# (/opt/morfsync par défaut), comme tous les autres services du parc :
# un dossier FIXE hors du clone git, que déplacer le dépôt ne casse pas.
#
# Installation manuelle :
#   (préférer ./service.py install, qui fait tout et migre l'ancienne config)
#   sed -e 's/__RUN_USER__/votreuser/g' -e 's#__RUN_HOME__#/home/votreuser#g' \
#       scripts/linux/morfsync.service | sudo tee /etc/systemd/system/morfsync.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now morfsync

[Unit]
Description=morfSync — socle de synchronisation offline-first
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
# $HOME et le dossier de travail sont imposés explicitement : pour un service
# SYSTEM avec User=, systemd ne fournit pas toujours $HOME, et %h vaudrait /root.
# Les données ne dépendent plus de $HOME (elles vivent sous /opt/morfsync/data),
# mais un HOME défini reste sain pour l'environnement du processus.
Environment=HOME=__RUN_HOME__
WorkingDirectory=__RUN_HOME__
# Crée et possède /var/lib/morfsystem/morfsync ; expose $STATE_DIRECTORY, que
# paths.cpp utilise comme dossier de données par défaut.
StateDirectory=morfsystem/morfsync
ExecStart=__APP_DIR__/morfSync __CONFIG_DIR__/morfsync.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
